<div class="mb-12">
    <div class="mb-4 flex justify-end gap-2">
        <button class="square-btn" @onclick="Prev">‹</button>
        <button class="square-btn" @onclick="Next">›</button>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
        @foreach (var t in CurrentPage)
        {
            <a href="/title/@t.TitleId"
               class="relative flex @Height flex-col justify-end overflow-hidden border-[3px] border-line bg-cover bg-center p-6 shadow-brutal"
               style="background-image:url('@t.ImageUrl')">
                <div class="absolute inset-0 bg-linear-to-t @(Large ? "from-[#112250]/95 from-20%" : "from-[#112250]/90 from-30%") to-transparent"></div>
                <div class="relative z-10">
                    <div class="font-display text-2xl font-black text-[#F5F4F0] @(Large ? "leading-[1.2]" : "")">@t.Name</div>
                    <p class="@(Large ? "mt-[0.4rem] text-[0.85rem]" : "mt-[0.2rem] text-[0.8rem]") text-[#E7E2CE]">@t.Desc</p>
                    <div class="@(Large ? "mt-[0.8rem]" : "mt-2") flex gap-2">
                        <span class="tag">@t.Tag1</span>
                        <span class="tag">@t.Tag2</span>
                    </div>
                </div>
            </a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SpotlightItem> Items { get; set; } = [];
    [Parameter] public int PageSize { get; set; } = 3;
    [Parameter] public string Height { get; set; } = "h-[380px]";
    [Parameter] public bool Large { get; set; }

    private int _page;
    private int Pages => Math.Max(1, (int)Math.Ceiling(Items.Count / (double)PageSize));
    private IEnumerable<SpotlightItem> CurrentPage => Items.Skip(_page * PageSize).Take(PageSize);

    private void Next() => _page = (_page + 1) % Pages;
    private void Prev() => _page = (_page - 1 + Pages) % Pages;
}