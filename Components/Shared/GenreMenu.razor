<div class="relative">
    <button type="button" class="pill @(Active ? "active" : "")" @onclick="Toggle">
        @(string.IsNullOrWhiteSpace(Selected) ? "Genre" : $"Genre: {Selected}") ▾
    </button>

    @if (_open)
    {
        <div class="fixed inset-0 z-20" @onclick="Close"></div>

        <div class="absolute left-0 top-full z-30 mt-2 max-h-80 w-60 overflow-y-auto border-2 border-line bg-page shadow-brutal">
            <div class="border-b-2 border-line bg-panel px-4 py-2 font-display text-[0.7rem] font-extrabold uppercase tracking-wider text-muted">
                Choose a genre
            </div>

            <button type="button"
                    class="flex w-full cursor-pointer items-center justify-between border-b border-line/30 px-4 py-3 text-left font-display text-sm font-bold text-ink hover:bg-ink hover:text-page @(string.IsNullOrWhiteSpace(Selected) ? "bg-panel" : "")"
                    @onclick='() => Pick("")'>
                <span>All Genres</span>
                @if (string.IsNullOrWhiteSpace(Selected))
                {
                    <span>✓</span>
                }
            </button>

            @foreach (var g in Genres)
            {
                var genre = g;
                var isSelected = string.Equals(Selected, genre, StringComparison.OrdinalIgnoreCase);

                <button type="button"
                        class="flex w-full cursor-pointer items-center justify-between border-b border-line/30 px-4 py-3 text-left font-display text-sm font-bold text-ink last:border-b-0 hover:bg-ink hover:text-page @(isSelected ? "bg-panel" : "")"
                        @onclick="() => Pick(genre)">
                    <span>@genre</span>
                    @if (isSelected)
                    {
                        <span>✓</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Genres { get; set; } = [];
    [Parameter] public string? Selected { get; set; }
    [Parameter] public bool Active { get; set; }

    // Raised with the genre name, or an empty string for "All Genres".
    [Parameter] public EventCallback<string> OnPick { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task Pick(string genre)
    {
        _open = false;
        await OnPick.InvokeAsync(genre);
    }
}