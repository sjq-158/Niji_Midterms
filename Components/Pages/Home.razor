@page "/"
@inject CatalogService Catalog

<PageTitle>niji - Read Webcomics &amp; Webnovels</PageTitle>

<section class="grid overflow-hidden border-b-[3px] border-line md:grid-cols-2">
    <div class="flex flex-col justify-center bg-accent px-12 py-16 text-[#F5F4F0] md:border-r-[3px] md:border-line">
        <h1 class="mb-5 font-display text-5xl font-black leading-[1.1]">@Hero.Title</h1>
        <p class="mb-8 leading-relaxed text-panel">@Hero.Desc</p>
        <a href="/comics" class="btn-cta self-start">Start Reading</a>
    </div>
    <div class="relative flex min-h-[380px] items-end bg-cover bg-center p-10"
         style="background-image:url('@Hero.Image')">
        <div class="absolute inset-0 bg-[#112250]/35"></div>
        <div class="absolute right-5 top-5 z-10 flex gap-2">
            <button class="square-btn" @onclick="PrevHero">‹</button>
            <button class="square-btn" @onclick="NextHero">›</button>
        </div>
        <div class="relative z-10 w-full border-[3px] border-line bg-page px-8 py-6 shadow-[6px_6px_0_var(--border-color)]">
            <span class="text-xs font-extrabold uppercase text-muted">@Hero.Tag</span>
            <h2 class="font-display text-3xl font-extrabold">@Hero.CardTitle</h2>
            <p class="mt-1 text-sm">@Hero.CardSub</p>
        </div>
    </div>
</section>

<div class="mx-auto max-w-[1280px] px-6 py-12">

    <div class="mb-6 border-b-2 border-line pb-2"><h2 class="section-title">Weekly Schedule</h2></div>
    <div class="mb-16 border-[3px] border-line bg-page shadow-brutal">
        <div class="flex border-b-[3px] border-line bg-panel">
            @foreach (var d in _days)
            {
                <button class="day-tab @(d == _day ? "active" : "")" @onclick="() => _day = d">
                    @d.ToString()[..3].ToUpper()
                </button>
            }
        </div>
        <div class="p-8">
            <div class="mb-6 flex items-center justify-between">
                <h3 class="font-display text-2xl font-black uppercase">@_day Lineup</h3>
                <div class="flex gap-2">
                    <button class="square-btn" @onclick="PrevDay">‹</button>
                    <button class="square-btn" @onclick="NextDay">›</button>
                </div>
            </div>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var (entry, title) in Catalog.GetSchedule(_day))
                {
                    <div class="cover-card shadow-brutal-sm">
                        <div class="h-48 border-b-2 border-line bg-cover bg-center" style="background-image:url('@title.ImageUrl')"></div>
                        <div class="p-4">
                            <div class="font-display font-extrabold">@title.Name</div>
                            <div class="mt-0.5 text-xs text-muted">@entry.Episode</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mb-6 flex items-end justify-between border-b-2 border-line pb-2">
        <h2 class="section-title">Top Trending Webtoons</h2>
        <a href="/comics" class="font-display font-bold text-ink">View All &rsaquo;</a>
    </div>
    <div class="mb-16 grid grid-cols-2 gap-6 md:grid-cols-5">
        @foreach (var (t, i) in Catalog.GetTrending().Select((t, i) => (t, i)))
        {
            <CoverCard Item="t" Rank="i + 1" Height="h-72" />
        }
    </div>

    <div class="mb-6 border-b-2 border-line pb-2"><h2 class="section-title">Explore Popular Genres</h2></div>
    <div class="mb-16 grid grid-cols-2 gap-4 md:grid-cols-5">
        @foreach (var (name, n) in _genres)
        {
            <div class="relative flex h-[120px] cursor-pointer items-end overflow-hidden border-2 border-line bg-cover bg-center p-3"
                 style="background-image:url('@CatalogService.Img(n, 400)')">
                <div class="absolute inset-0 bg-linear-to-t from-[#112250]/85 to-transparent"></div>
                <span class="relative z-10 font-display font-extrabold uppercase text-[#F5F4F0]">@name</span>
            </div>
        }
    </div>

    <div class="grid border-[3px] border-line bg-panel md:grid-cols-[300px_1fr]">
        <div class="min-h-[250px] border-line bg-cover bg-center md:border-r-[3px]"
             style="background-image:url('@CatalogService.Img(3, 600)')"></div>
        <div class="flex flex-col justify-center p-10">
            <span class="font-display text-xs font-extrabold uppercase text-muted">niji exclusive webnovel</span>
            <h3 class="my-1.5 font-display text-3xl font-black">Omniscient Reader's Viewpoint</h3>
            <p class="mb-6 text-sm">Immerse yourself in the dark fantasy webnovel that inspired the hit webcomic. Read all published chapters free with Pass on niji.</p>
            <a href="/novels" class="btn-cta self-start !px-5 !py-2.5 text-sm">Read Webnovel</a>
        </div>
    </div>
</div>

@code {
    private record HeroSlide(string Title, string Desc, string Image, string Tag, string CardTitle, string CardSub);

    private readonly HeroSlide[] _slides =
    [
        new("Discover Your Next Favorite Story",
            "Explore thousands of digital webcomics and light novels updated daily. Dive into high-stakes action, romance, and exclusive niji original series.",
            CatalogService.Img(5, 1200), "FEATURED ORIGINAL", "Omniscient Reader's Viewpoint", "The world has ended, and a new novel has begun."),
        new("Unleash Epic Fantasy Worlds",
            "Journey across magical kingdoms and witness legendary battles between gods and mortals in our curated fantasy catalog.",
            CatalogService.Img(3, 1200), "NEW SEASON", "Solo Leveling", "Rise from the weakest hunter to the sovereign of shadows.")
    ];

    private readonly DayOfWeek[] _days =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    ];

    private readonly (string, int)[] _genres = [("Romance", 2), ("Fantasy", 5), ("Action", 1), ("Thriller", 0), ("Sci-Fi", 4)];

    private int _hero;
    private DayOfWeek _day = DayOfWeek.Monday;
    private HeroSlide Hero => _slides[_hero];

    private void NextHero() => _hero = (_hero + 1) % _slides.Length;
    private void PrevHero() => _hero = (_hero - 1 + _slides.Length) % _slides.Length;

    private void NextDay() => _day = _days[(Array.IndexOf(_days, _day) + 1) % _days.Length];
    private void PrevDay() => _day = _days[(Array.IndexOf(_days, _day) - 1 + _days.Length) % _days.Length];
}